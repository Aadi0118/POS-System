# Root .gitignore for POS + KDS Restaurant System

# Node modules & dependencies
node_modules/
.pnp
.pnp.js

# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Expo & Mobile builds
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.keystore

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

