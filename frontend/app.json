{
  "expo": {
    "name": "Spicy Zaika POS & KDS",
    "slug": "restaurant-pos-kds",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antigravity.restaurantposkds"
    },
    "android": {
      "package": "com.antigravity.restaurantposkds",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Spicy Zaika POS to securely authenticate staff credentials."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "abe881c4-abeb-4fa6-83c7-1310611ff0cd"
      }
    }
  }
}
