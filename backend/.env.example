# ==========================================================
# RESTAURANT POS + KDS BACKEND CONFIGURATION
# STRICT CREDENTIAL MANAGEMENT: NO HARDCODED SECRETS
# ==========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# In production, use your MongoDB Atlas cluster URI or authenticated replica set
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_pos

# Authentication Security (JWT)
# Generate a strong 256-bit or 512-bit secret for production (e.g. openssl rand -base64 48)
JWT_SECRET=super_secure_jwt_secret_pos_kds_auth_token_key_change_in_production_min32chars
JWT_EXPIRES_IN=8h

# CORS Allowed Origin
# In production, specify exact client origins (e.g. exp://192.168.1.10:8081, http://localhost:8081)
# Use comma-separated list or '*' during local development
CORS_ORIGIN=*

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=5

